{
    "type": "bread-compact-wifi-lcd",
    "target": "esp32s3",
    "builds": [
        {
            "name": "bread-compact-wifi-lcd",
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X320=y"
            ]
        },
        {
            "name": "bread-compact-wifi-lcd-154",
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X240=y",
                "CONFIG_LCD_MODERN_UI=y",
                "CONFIG_USE_WECHAT_MESSAGE_STYLE=y",
                "CONFIG_LANGUAGE_VI_VN=y",
                "CONFIG_ENABLE_GPIO_WEB_CONFIG=y"
            ]
        }
    ]
}
